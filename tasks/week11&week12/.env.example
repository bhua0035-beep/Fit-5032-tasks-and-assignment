# Add this value to .env.local for local development, to the Cloudflare Pages
# build environment, and to the VITE_OPENWEATHER_API_KEY GitHub Actions secret.
VITE_OPENWEATHER_API_KEY=replace_with_your_openweather_api_key

# Leave this as / for local development and Cloudflare Pages. GitHub Actions
# sets the repository sub-path automatically in its workflow.
VITE_BASE_PATH=/
